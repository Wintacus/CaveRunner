{
  "name": "cave-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cave Runner \u2014 a 2D side-scrolling auto-runner set in a bioluminescent cave.",
  "scripts": {
    "assets": "node tools/build-tileset.mjs && node tools/build-icon.mjs && node tools/build-level.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "validate": "node tools/validate-level.mjs",
    "serve:test": "vite preview --port 4173",
    "smoke": "node tools/smoke-test.mjs",
    "autoplay": "node tools/autoplay.mjs",
    "test": "npm run build && node tools/run-tests.mjs",
    "pacing": "node tools/pacing-report.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.1"
  }
}
